# ========================================================
# PayLock (ForiPay) — Environment Configuration Template
# ========================================================
# Copy this file to .env.local:
#   cp .env.example .env.local

# --------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & SIMULATION TOGGLES
# --------------------------------------------------------
# Set to 'development' for local testing; 'production' for live deployment.
NODE_ENV=development

# Sandbox / Simulation Switch:
# 'on'  = Local testing with 1-click fake block advancement & simulated checkout ($0 cost).
# 'off' = 100% Real-World Production. Hides all test buttons, disables fake payment APIs,
#         and requires authentic blockchain miners & crypto wallets.
SandBox_FakeTest_Simulation=on
NEXT_PUBLIC_SANDBOX_SIMULATION=on

# --------------------------------------------------------
# 2. NOWPAYMENTS CRYPTO GATEWAY (API V1)
# --------------------------------------------------------
# Register at https://account.nowpayments.io to get your API keys.
# Sandbox API keys: https://account-sandbox.nowpayments.io
NOWPAYMENTS_API_KEY=YOUR_NOWPAYMENTS_API_KEY_HERE
NOWPAYMENTS_IPN_SECRET=YOUR_NOWPAYMENTS_IPN_SECRET_HERE

# Gateway Target: 'sandbox' (Mock Testnet) or 'production' (Live Mainnet Blockchain)
NOWPAYMENTS_ENV=sandbox

# --------------------------------------------------------
# 3. DATABASE (MONGODB ATLAS OR LOCAL)
# --------------------------------------------------------
# Local MongoDB: mongodb://localhost:27017/paylock
# MongoDB Atlas Cloud: mongodb+srv://<username>:<password>@cluster0.mongodb.net/paylock?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/paylock

# --------------------------------------------------------
# 4. PUBLIC APPLICATION URL
# --------------------------------------------------------
# For Localhost: http://localhost:3000
# For Production: https://yourdomain.com (Without trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --------------------------------------------------------
# 5. NODEMAILER EMAIL DISPATCHER (INVOICE & RECEIPT EMAILS)
# --------------------------------------------------------
# If using Gmail, generate a 16-character App Password at:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="PayLock Billing <your-email@gmail.com>"

# --------------------------------------------------------
# 6. SYSTEM ADMINISTRATOR IDENTITY (RBAC ROOT)
# --------------------------------------------------------
# Credentials to access the global /admin management console
ADMIN_EMAIL=admin@paylock.io
ADMIN_PASSWORD=AdminPayLock2026!
